web: echo "=== CHECKING MIGRATIONS ===" && python manage.py showmigrations --noinput 2>&1 && echo "=== RUNNING MIGRATE ===" && python manage.py migrate --noinput --verbosity 3 2>&1 && echo "=== COLLECTSTATIC ===" && python manage.py collectstatic --noinput --no-post-process 2>&1 && echo "=== CREATE ADMIN ===" && python scripts/create_superuser.py 2>&1 && echo "=== STARTING GUNICORN ===" && gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --log-level debug 2>&1